    {"id": "u1-shutdown-bed", "glob": "~/.cache/3d-cli/vision/now/u1-shutdown*.jpg", "label": "empty_bed", "printer": "snapmaker-u1", "group": "u1-idle", "split": "test", "every": 1, "keep": [0, 0.3, 1, 1]},
    {"id": "u1-healthy-print", "glob": "~/.cache/3d-cli/vision/now/u1.jpg", "label": "healthy", "printer": "snapmaker-u1", "group": "u1-print-g", "split": "test", "every": 1, "keep": [0, 0.3, 1, 1]},
