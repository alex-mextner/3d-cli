{
  "_comment": "Provenance of every frame the tier (b) training set can contain. `own` frames come from the owner's printers (Snapmaker U1, Creality K1 SE): they may be published after sanitation (CC-BY-4.0). `third_party` frames come from the public collection documented in docs/research/printer-vision-tuning.md (licences differ, most are local-eval-only): they are used for training/evaluation on the server and are NEVER published. Paths are local to the workstation that ran the capture; `keep` is the normalised x1,y1,x2,y2 crop of the published pixels (everything outside it, e.g. the back wall of the chamber with its QR stickers, never leaves the machine).",
  "own": [
    {"id": "u1-timelapse-a", "glob": "~/.cache/3d-cli/vision/data/frames/quant/*.jpg", "label": "healthy", "printer": "snapmaker-u1", "group": "u1-print-a", "split": "train", "every": 12, "keep": [0, 0.3, 1, 1]},
    {"id": "u1-timelapse-b", "glob": "~/.cache/3d-cli/vision/data/frames/obj/*.jpg", "label": "healthy", "printer": "snapmaker-u1", "group": "u1-print-b", "split": "train", "every": 6, "keep": [0, 0.3, 1, 1]},
    {"id": "u1-timelapse-c", "glob": "~/.cache/3d-cli/vision/data/frames/shelf/*.jpg", "label": "healthy", "printer": "snapmaker-u1", "group": "u1-print-c", "split": "train", "every": 12, "keep": [0, 0.3, 1, 1]},
    {"id": "u1-timelapse-d", "glob": "~/.cache/3d-cli/vision/data/frames/Fast_Funnel_small/*.jpg", "label": "healthy", "printer": "snapmaker-u1", "group": "u1-print-d", "split": "test", "every": 6, "keep": [0, 0.3, 1, 1]},
    {"id": "u1-timelapse-e", "glob": "~/.cache/3d-cli/vision/data/frames/Ja-back__2_/*.jpg", "label": "healthy", "printer": "snapmaker-u1", "group": "u1-print-e", "split": "test", "every": 6, "keep": [0, 0.3, 1, 1]},
    {"id": "u1-live-walls", "glob": "~/.cache/3d-cli/vision/data/u1rec_walls/*.jpg", "label": "healthy", "printer": "snapmaker-u1", "group": "u1-print-f", "split": "train", "every": 12, "keep": [0, 0.3, 1, 1]},
    {"id": "u1-idle-bed", "glob": "~/.cache/3d-cli/vision/data/eval/neg_live_idle/*.jpg", "label": "empty_bed", "printer": "snapmaker-u1", "group": "u1-idle", "split": "train", "every": 3, "keep": [0, 0.3, 1, 1]},
